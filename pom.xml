<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
        <relativePath/>
    </parent>

    <groupId>cn.kong</groupId>
    <artifactId>eon-kb</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Eon Knowledge Base</name>
    <description>Eon 知识库 - 基于 Spring AI 的智能知识管理与问答系统</description>

    <modules>
        <module>kb-core</module>
        <module>kb-server</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <spring-ai.version>1.1.8</spring-ai.version>
        <flexmark.version>0.64.8</flexmark.version>
        <jsoup.version>1.18.1</jsoup.version>
        <llama-cloud.version>1.7.0</llama-cloud.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 本项目模块，供 kb-server 依赖 kb-core -->
            <dependency>
                <groupId>cn.kong</groupId>
                <artifactId>kb-core</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
