<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.kong.kb.mapper.DocumentMapper">

    <!-- ============================ 结果映射 ============================ -->
    <resultMap id="DocumentResultMap" type="cn.kong.kb.domain.KbDocument">
        <id property="id" column="id"
            typeHandler="cn.kong.kb.config.UUIDTypeHandler"/>
        <result property="fileName" column="file_name"/>
        <result property="fileType" column="file_type"/>
        <result property="fileSize" column="file_size"/>
        <result property="originalPath" column="original_path"/>
        <result property="chunkCount" column="chunk_count"/>
        <result property="status" column="status"/>
        <result property="parseMode" column="parse_mode"/>
        <result property="errorMessage" column="error_message"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!-- ============================ 可复用列 ============================ -->
    <sql id="documentColumns">
        id, file_name, file_type, file_size, original_path,
        chunk_count, status, parse_mode, error_message, created_at, updated_at
    </sql>

    <!-- ============================ 插入 ============================ -->
    <!-- PostgreSQL：通过 useGeneratedKeys + keyColumn 将 gen_random_uuid() 生成的值回写到 KbDocument.id -->
    <insert id="insert" parameterType="cn.kong.kb.domain.KbDocument"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO documents (file_name, file_type, file_size, original_path, status, parse_mode)
        VALUES (#{fileName}, #{fileType},
                <choose>
                    <when test="fileSize != null">#{fileSize}</when>
                    <otherwise>0</otherwise>
                </choose>,
                #{originalPath}, #{status}, #{parseMode})
    </insert>

    <!-- ============================ 更新 ============================ -->
    <update id="updateStatus">
        UPDATE documents
        SET status = #{status},
            error_message = #{errorMessage},
            updated_at = NOW()
        WHERE id = #{id}
    </update>

    <update id="updateChunkCount">
        UPDATE documents
        SET chunk_count = #{chunkCount},
            updated_at = NOW()
        WHERE id = #{id}
    </update>

    <!-- ============================ 查询 ============================ -->
    <select id="findById" resultMap="DocumentResultMap">
        SELECT <include refid="documentColumns"/>
        FROM documents
        WHERE id = #{id}
    </select>

    <select id="findAll" resultMap="DocumentResultMap">
        SELECT <include refid="documentColumns"/>
        FROM documents
        ORDER BY created_at DESC
    </select>

    <select id="findByKnowledgeBaseId" resultMap="DocumentResultMap">
        SELECT d.*
        FROM documents d
        INNER JOIN document_knowledge_bases dkb ON dkb.document_id = d.id
        WHERE dkb.knowledge_base_id = #{knowledgeBaseId}
        ORDER BY d.created_at DESC
    </select>

    <!-- ============================ 删除 ============================ -->
    <delete id="deleteById">
        DELETE FROM documents WHERE id = #{id}
    </delete>

</mapper>
